# ── Google Cloud / Vertex AI (required for real Gemini calls) ──────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# ── Security (optional — leave blank to disable in dev) ───────────────────
# Set to a strong random string in production to require X-Api-Key header
API_KEY=

# CORS: comma-separated allowed origins, or * for dev
ALLOWED_ORIGINS=*

# ── Behaviour ─────────────────────────────────────────────────────────────
# Maximum concurrent agent sessions (protects server resources)
# MAX_CONCURRENT_SESSIONS=10
